    },
    "Format HN Stories": {
      "main": [[{ "node": "Merge All Sources", "type": "main", "index": 0 }]]
    },
    "AI News - Fetch": {
      "main": [[{ "node": "Format AI News", "type": "main", "index": 0 }]]
    },
    "Format AI News": {
      "main": [[{ "node": "Merge All Sources", "type": "main", "index": 0 }]]
    },
    "Fetch GitHub Trending": {
      "main": [[{ "node": "Format GitHub", "type": "main", "index": 0 }]]
    },
    "Format GitHub": {
      "main": [[{ "node": "Merge All Sources", "type": "main", "index": 0 }]]
    },
    "Merge All Sources": {
      "main": [[{ "node": "Collect Into Single Item", "type": "main", "index": 0 }]]
    },
    "Collect Into Single Item": {
      "main": [[{ "node": "AI Summarizer", "type": "main", "index": 0 }]]
    },
    "OpenAI Model": {
      "ai_languageModel": [[{ "node": "AI Summarizer", "type": "ai_languageModel", "index": 0 }]]
    },
    "AI Summarizer": {
      "main": [[{ "node": "Format Email", "type": "main", "index": 0 }]]
    },
    "Format Email": {
      "main": [[{ "node": "Send Email", "type": "main", "index": 0 }]]
    },
    "Send Email": {
      "main": [[{ "node": "Log Execution", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "timezone": "UTC", "saveManualExecutions": true },
  "tags": ["scheduled", "briefing", "news"],
  "active": false
}
